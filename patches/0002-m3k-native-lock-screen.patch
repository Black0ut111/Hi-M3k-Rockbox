 #define MAX_LINE 1024
 
@@ -860,6 +868,88 @@ void skin_render_viewport(struct skin_element* viewport, struct gui_wps *gwps,
 static bool inhibit_flush = false;
 static bool pending_full_update = false;
 
+#ifdef FIIO_M3K
+static int m3k_lock_aa_slot = -1;
+
+static void m3k_draw_lock_screen(struct gui_wps *gwps)
+{
+    struct screen *display = gwps->display;
+
+    if (display->screen_type != SCREEN_MAIN || !is_keys_locked())
+        return;
+
+    struct tm *now = get_time();
+    struct mp3entry *id3 = audio_current_track();
+    char buf[64];
+    int width;
+    int height;
+
+    display->set_viewport(NULL);
+    display->scroll_stop();
+    display->setfont(display->getuifont());
+    display->set_background(LCD_RGBPACK(0x18, 0x14, 0x18));
+    display->set_foreground(LCD_RGBPACK(0xd8, 0xdc, 0xe0));
+    display->clear_display();
+
+#ifdef HAVE_ALBUMART
+    if (m3k_lock_aa_slot < 0)
+    {
+        struct dim dim = {LCD_WIDTH, LCD_WIDTH};
+        m3k_lock_aa_slot = playback_claim_aa_slot(&dim);
+        playback_update_aa_dims();
+    }
+
+    int aa_handle = playback_current_aa_hid(m3k_lock_aa_slot);
+    struct bitmap *bmp;
+    if (aa_handle >= 0 && bufgetdata(aa_handle, 0, (void *)&bmp) > 0)
+    {
+        int width = MIN(bmp->width, LCD_WIDTH);
+        int height = MIN(bmp->height, 236);
+        int src_x = MAX(0, (bmp->width - width) / 2);
+        int src_y = MAX(0, (bmp->height - height) / 2);
+        int x = (LCD_WIDTH - width) / 2;
+
+        display->bitmap_part((fb_data *)bmp->data, src_x, src_y,
+                             STRIDE(display->screen_type, bmp->width, bmp->height),
+                             x, 0, width, height);
+    }
+#endif
+
+    display->set_foreground(LCD_BLACK);
+    display->getstringsize((const unsigned char *)"L O C K E D", &width, &height);
+    display->putsxy((LCD_WIDTH - width) / 2 + 1, 23,
+                    (const unsigned char *)"L O C K E D");
+    display->set_foreground(LCD_WHITE);
+    display->getstringsize((const unsigned char *)"L O C K E D", &width, &height);
+    display->putsxy((LCD_WIDTH - width) / 2, 22,
+                    (const unsigned char *)"L O C K E D");
+
+    display->set_foreground(LCD_BLACK);
+    display->fillrect(0, 236, LCD_WIDTH, 84);
+
+    snprintf(buf, sizeof(buf), "%02d:%02d", now->tm_hour, now->tm_min);
+    display->set_foreground(LCD_WHITE);
+    display->set_drawmode(DRMODE_FG);
+    display->getstringsize((const unsigned char *)buf, &width, &height);
+    display->putsxy(14, 250, (const unsigned char *)buf);
+
+    snprintf(buf, sizeof(buf), "%d%%", battery_level());
+    display->getstringsize((const unsigned char *)buf, &width, &height);
+    display->putsxy(LCD_WIDTH - width - 14, 250, (const unsigned char *)buf);
+    display->set_drawmode(DRMODE_SOLID);
+
+    if (id3)
+    {
+        int progress = id3->length ? (int)((uint64_t)id3->elapsed * 180 / id3->length) : 0;
+
+        display->set_foreground(LCD_RGBPACK(0x68, 0x9b, 0xc8));
+        display->fillrect(30, 292, 180, 5);
+        display->set_foreground(LCD_WHITE);
+        display->fillrect(30, 292, progress, 5);
+    }
+}
+#endif
+
 void skin_render_inhibit_flush(bool inhibit)
 {
     inhibit_flush = inhibit;
