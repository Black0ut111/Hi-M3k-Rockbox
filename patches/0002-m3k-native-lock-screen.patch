+#ifdef FIIO_M3K
+static void m3k_draw_lock_screen(struct screen *display)
+{
+    if (display->screen_type != SCREEN_MAIN || !is_keys_locked())
+        return;
+
+    struct tm *now = get_time();
+    struct mp3entry *id3 = audio_current_track();
+    char buf[64];
+    int width;
+    int height;
+
+    display->set_viewport(NULL);
+    display->scroll_stop();
+    display->setfont(display->getuifont());
+    display->set_background(LCD_RGBPACK(0x18, 0x14, 0x18));
+    display->set_foreground(LCD_RGBPACK(0xd8, 0xdc, 0xe0));
+    display->clear_display();
+
+    display->getstringsize((const unsigned char *)"L O C K E D", &width, &height);
+    display->putsxy((LCD_WIDTH - width) / 2, 22,
+                    (const unsigned char *)"L O C K E D");
+
+    snprintf(buf, sizeof(buf), "%02d:%02d", now->tm_hour, now->tm_min);
+    display->getstringsize((const unsigned char *)buf, &width, &height);
+    display->putsxy((LCD_WIDTH - width) / 2, 72, (const unsigned char *)buf);
+
+    snprintf(buf, sizeof(buf), "%04d-%02d-%02d", now->tm_year + 1900,
+             now->tm_mon + 1, now->tm_mday);
+    display->set_foreground(LCD_RGBPACK(0x90, 0x8c, 0x98));
+    display->getstringsize((const unsigned char *)buf, &width, &height);
+    display->putsxy((LCD_WIDTH - width) / 2, 104, (const unsigned char *)buf);
+
+    display->set_foreground(LCD_RGBPACK(0x20, 0x20, 0x28));
+    display->fillrect(0, 202, LCD_WIDTH, 118);
+
+    if (id3)
+    {
+        const char *title = id3->title ? id3->title : id3->path;
+        const char *artist = id3->artist ? id3->artist : "Unknown artist";
+        unsigned long elapsed = id3->elapsed / 1000;
+        unsigned long length = id3->length / 1000;
+        int progress = id3->length ? (int)((uint64_t)id3->elapsed * 180 / id3->length) : 0;
+
+        display->set_foreground(LCD_RGBPACK(0xd8, 0xdc, 0xe0));
+        display->getstringsize((const unsigned char *)title, &width, &height);
+        display->putsxy(MAX(8, (LCD_WIDTH - width) / 2), 218,
+                        (const unsigned char *)title);
+
+        display->set_foreground(LCD_RGBPACK(0x90, 0x8c, 0x98));
+        display->getstringsize((const unsigned char *)artist, &width, &height);
+        display->putsxy(MAX(8, (LCD_WIDTH - width) / 2), 246,
+                        (const unsigned char *)artist);
+
+        snprintf(buf, sizeof(buf), "%02lu:%02lu", elapsed / 60, elapsed % 60);
+        display->putsxy(10, 282, (const unsigned char *)buf);
+        snprintf(buf, sizeof(buf), "%02lu:%02lu", length / 60, length % 60);
+        display->getstringsize((const unsigned char *)buf, &width, &height);
+        display->putsxy(LCD_WIDTH - width - 10, 282, (const unsigned char *)buf);
+
+        display->set_foreground(LCD_RGBPACK(0x40, 0x40, 0x48));
+        display->fillrect(30, 309, 180, 4);
+        display->set_foreground(LCD_RGBPACK(0xb8, 0xac, 0xc8));
+        display->fillrect(30, 309, progress, 4);
+    }
+}
+#endif
+
 void skin_render_inhibit_flush(bool inhibit)
