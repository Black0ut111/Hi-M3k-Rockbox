+#ifdef FIIO_M3K
+static const char *crazypod_m3k_label(const struct menu_item_ex *item)
+{
+#ifdef HAVE_TAGCACHE
+    if (item == &pictureflow_item) return "Cover Flow";
+    if (item == &db_browser) return "Music";
+#endif
+    if (item == &file_browser) return "Files";
+    if (item == &wps_item) return "Now Playing";
+    if (item == &playlists) return "Playlists";
+    if (item == &rocks_browser) return "Apps";
+    if (item == &shortcut_menu) return "Favorites";
+    if (item == &menu_) return "Settings";
+    if (item == &system_menu_) return "System";
+    return "Rockbox";
+}
+
+static void crazypod_m3k_center_text(const char *text, int y)
+{
+    int width;
+    lcd_getstringsize((const unsigned char *)text, &width, NULL);
+    lcd_putsxy((LCD_WIDTH - width) / 2, y, text);
+}
+
+static void crazypod_m3k_draw_icon(int selection, int x, int y)
+{
+    int kind = selection % 6;
+
+    lcd_set_foreground(LCD_WHITE);
+    if (kind == 0)
+    {
+        lcd_drawrect(x + 7, y + 5, 42, 48);
+        lcd_drawline(x + 15, y + 39, x + 40, y + 14);
+        lcd_drawline(x + 15, y + 39, x + 40, y + 39);
+    }
+    else if (kind == 1)
+    {
+        lcd_drawrect(x + 8, y + 8, 40, 40);
+        lcd_fillrect(x + 17, y + 26, 7, 13);
+        lcd_fillrect(x + 31, y + 18, 7, 21);
+    }
+    else if (kind == 2)
+    {
+        lcd_drawrect(x + 6, y + 14, 44, 34);
+        lcd_drawline(x + 6, y + 14, x + 22, y + 14);
+        lcd_drawline(x + 22, y + 14, x + 28, y + 8);
+        lcd_drawline(x + 28, y + 8, x + 45, y + 8);
+    }
+    else if (kind == 3)
+    {
+        lcd_drawrect(x + 9, y + 8, 38, 43);
+        lcd_fillrect(x + 20, y + 18, 5, 23);
+        lcd_fillrect(x + 32, y + 18, 5, 23);
+    }
+    else if (kind == 4)
+    {
+        lcd_drawrect(x + 8, y + 10, 40, 42);
+        lcd_drawline(x + 18, y + 5, x + 18, y + 16);
+        lcd_drawline(x + 38, y + 5, x + 38, y + 16);
+        lcd_drawline(x + 14, y + 27, x + 42, y + 27);
+        lcd_drawline(x + 14, y + 38, x + 42, y + 38);
+    }
+    else
+    {
+        lcd_drawrect(x + 8, y + 8, 40, 40);
+        lcd_drawrect(x + 18, y + 18, 20, 20);
+        lcd_fillrect(x + 25, y + 2, 6, 12);
+        lcd_fillrect(x + 25, y + 43, 6, 12);
+    }
+}
+
+static void crazypod_m3k_draw_home(int selection)
+{
+    static const unsigned colors[] = {
+        LCD_RGBPACK(231, 70, 86), LCD_RGBPACK(80, 132, 255),
+        LCD_RGBPACK(54, 190, 150), LCD_RGBPACK(160, 92, 245),
+        LCD_RGBPACK(240, 155, 55), LCD_RGBPACK(44, 176, 214)
+    };
+    char status[32];
+    int count = MENU_GET_COUNT(root_menu_.flags);
+    int battery = battery_level();
+
+    lcd_set_drawmode(DRMODE_SOLID);
+    lcd_set_background(LCD_RGBPACK(12, 14, 23));
+    lcd_set_foreground(LCD_RGBPACK(12, 14, 23));
+    lcd_clear_display();
+
+    lcd_set_foreground(LCD_RGBPACK(225, 229, 240));
+    lcd_putsxy(12, 9, "CrazyPod");
+    snprintf(status, sizeof(status), "%d%%", battery < 0 ? 0 : battery);
+    {
+        int width;
+        lcd_getstringsize((const unsigned char *)status, &width, NULL);
+        lcd_putsxy(LCD_WIDTH - width - 12, 9, status);
+    }
+
+    lcd_set_foreground(LCD_RGBPACK(34, 38, 54));
+    lcd_fillrect(0, 35, 18, 181);
+    lcd_fillrect(LCD_WIDTH - 18, 35, 18, 181);
+
+    lcd_set_foreground(colors[selection % ARRAYLEN(colors)]);
+    lcd_fillrect(28, 48, LCD_WIDTH - 56, 180);
+    lcd_set_foreground(LCD_RGBPACK(255, 255, 255));
+    lcd_drawrect(28, 48, LCD_WIDTH - 56, 180);
+    crazypod_m3k_draw_icon(selection, (LCD_WIDTH - 56) / 2, 84);
+
+    lcd_set_foreground(LCD_WHITE);
+    crazypod_m3k_center_text(crazypod_m3k_label(root_menu__[selection]), 163);
+    lcd_set_foreground(LCD_RGBPACK(230, 235, 245));
+    crazypod_m3k_center_text("SELECT TO OPEN", 194);
+
+    for (int i = 0; i < count; i++)
+    {
+        int x = (LCD_WIDTH - count * 10) / 2 + i * 10;
+        lcd_set_foreground(i == selection ? LCD_WHITE : LCD_RGBPACK(76, 82, 102));
+        lcd_fillrect(x, 251, i == selection ? 7 : 4, 4);
+    }
+
+    lcd_set_foreground(LCD_RGBPACK(145, 152, 172));
+    crazypod_m3k_center_text("UP / DOWN  browse", 282);
+    lcd_update();
+}
+
+static int crazypod_m3k_home(int *selection)
+{
+    int count = MENU_GET_COUNT(root_menu_.flags);
+
+    if (*selection < 0 || *selection >= count)
+        *selection = 0;
+
+    while (true)
+    {
+        int action;
+        crazypod_m3k_draw_home(*selection);
+        action = get_action(CONTEXT_MAINMENU, TIMEOUT_BLOCK);
+
+        if (action == ACTION_STD_PREV || action == ACTION_STD_PREVREPEAT)
+            *selection = (*selection + count - 1) % count;
+        else if (action == ACTION_STD_NEXT || action == ACTION_STD_NEXTREPEAT)
+            *selection = (*selection + 1) % count;
+        else if (action == ACTION_STD_OK)
+        {
+            const struct menu_item_ex *item = root_menu__[*selection];
+            if ((item->flags & MENU_TYPE_MASK) == MT_RETURN_VALUE)
+                return item->value;
+            return do_menu(item, NULL, NULL, false);
+        }
+        else if (action == ACTION_TREE_WPS)
+            return GO_TO_WPS;
+        else if (action == ACTION_STD_MENU || action == ACTION_STD_QUICKSCREEN)
+            return GO_TO_MAINMENU;
+        else if (default_event_handler(action) == SYS_USB_CONNECTED)
+            return MENU_ATTACHED_USB;
+    }
+}
