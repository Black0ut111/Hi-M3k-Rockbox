+static void crazypod_m3k_draw_playing(bool update)
+{
+    struct mp3entry *id3 = audio_current_track();
+
+    if (crazypod_m3k_wallpaper_loaded)
+        lcd_bmp_part(&crazypod_m3k_wallpaper, 12, 234, 12, 234,
+                     LCD_WIDTH - 24, 42);
+    else
+    {
+        lcd_set_foreground(LCD_RGBPACK(12, 14, 23));
+        lcd_fillrect(12, 234, LCD_WIDTH - 24, 42);
+    }
+    if ((audio_status() & AUDIO_STATUS_PLAY) && id3)
+    {
+        const char *title = id3->title ? id3->title : "Now Playing";
+        const char *artist = id3->artist ? id3->artist : "Unknown artist";
+        int progress = id3->length > 0 ? id3->elapsed * (LCD_WIDTH - 24) /
+                       id3->length : 0;
+        lcd_set_drawmode(DRMODE_FG);
+        lcd_set_foreground(LCD_WHITE);
+        lcd_putsxy(20, 239,
+                   (audio_status() & AUDIO_STATUS_PAUSE) ? ">" : "||");
+        crazypod_m3k_scroll_text(title, 39, 239, LCD_WIDTH - 59, 3);
+        lcd_set_foreground(LCD_RGBPACK(170, 178, 198));
+        crazypod_m3k_scroll_text(artist, 20, 256, LCD_WIDTH - 40, 4);
+        lcd_set_drawmode(DRMODE_SOLID);
+        lcd_set_foreground(LCD_RGBPACK(83, 91, 112));
+        lcd_fillrect(12, 273, LCD_WIDTH - 24, 3);
+        lcd_set_foreground(LCD_RGBPACK(245, 92, 110));
+        lcd_fillrect(12, 273, progress, 3);
+    }
+
+    if (update)
+        lcd_update_rect(12, 234, LCD_WIDTH - 24, 42);
+}
+
+static int crazypod_m3k_icon_index(const struct menu_item_ex *item)
+{
+#ifdef HAVE_TAGCACHE
+    if (item == &pictureflow_item) return 0;
+    if (item == &db_browser) return 1;
+#endif
+    if (item == &file_browser) return 2;
+    if (item == &wps_item) return 3;
+    if (item == &playlists) return 4;
+    if (item == &rocks_browser) return 5;
+    if (item == &shortcut_menu) return 6;
+    if (item == &menu_) return 7;
+    if (item == &system_menu_) return 8;
+    return 1;
+}
+
+static void crazypod_m3k_draw_menu_icon(int selection, int x, int y)
+{
+    int icon = crazypod_m3k_icon_index(root_menu__[selection]);
+
+    if (crazypod_m3k_icons_loaded)
+        lcd_bmp_part(&crazypod_m3k_icons, 0, icon * CRAZYPOD_ICON_SIZE,
+                     x, y, CRAZYPOD_ICON_SIZE, CRAZYPOD_ICON_SIZE);
+}
+
+static void crazypod_m3k_draw_home(int selection, int offset)
+{
+    char status[32];
+    int count = MENU_GET_COUNT(root_menu_.flags);
+    int previous = (selection + count - 1) % count;
+    int next = (selection + 1) % count;
+    int battery = battery_level();
+    struct tm *now = get_time();
+
+    lcd_set_drawmode(DRMODE_SOLID);
+    lcd_set_background(LCD_RGBPACK(12, 14, 23));
+    if (crazypod_m3k_wallpaper_loaded)
+        lcd_bmp(&crazypod_m3k_wallpaper, 0, 0);
+    else
+    {
+        lcd_set_foreground(LCD_RGBPACK(12, 14, 23));
+        lcd_clear_display();
+    }
+
+    lcd_set_drawmode(DRMODE_FG);
+    lcd_set_foreground(LCD_RGBPACK(225, 229, 240));
+    lcd_putsxy(12, 9, "Hi-M3K");
+    snprintf(status, sizeof(status), "%02d:%02d  %d%%", now->tm_hour,
+             now->tm_min, battery < 0 ? 0 : battery);
+    {
+        int width;
+        lcd_getstringsize((const unsigned char *)status, &width, NULL);
+        lcd_putsxy(LCD_WIDTH - width - 12, 9, status);
+    }
+    lcd_set_drawmode(DRMODE_SOLID);
+
+    crazypod_m3k_draw_menu_icon(previous, 72 - 128 + offset, 76);
+    crazypod_m3k_draw_menu_icon(next, 72 + 128 + offset, 76);
+    crazypod_m3k_draw_menu_icon(selection, 72 + offset, 76);
+
+    crazypod_m3k_draw_playing(false);
+
+    for (int i = 0; i < count; i++)
+    {
+        int x = (LCD_WIDTH - count * 10) / 2 + i * 10;
+        lcd_set_foreground(i == selection ? LCD_WHITE : LCD_RGBPACK(76, 82, 102));
+        lcd_fillrect(x, 286, i == selection ? 7 : 4, 4);
+    }
+
+    lcd_update();
+}
+
+static void crazypod_m3k_animate(int selection, int direction)
+{
+    static const unsigned char easing[] = {128, 84, 48, 22, 7, 0};
+    int sign = direction > 0 ? 1 : -1;
+
+    for (unsigned frame = 0; frame < ARRAYLEN(easing); frame++)
+    {
+        crazypod_m3k_draw_home(selection, sign * easing[frame]);
+        sleep(HZ / 100 + 1);
+    }
+}
+
+static int crazypod_m3k_home(int *selection)
+{
+    int count = MENU_GET_COUNT(root_menu_.flags);
+    int result = GO_TO_ROOT;
+    char last_track[MAX_PATH] = "";
+
+    crazypod_m3k_apply_theme();
+    crazypod_m3k_load_assets();
+
+    if (*selection < 0 || *selection >= count)
+        *selection = 0;
+
+    {
+        struct mp3entry *id3 = audio_current_track();
+        if (id3)
+            strmemccpy(last_track, id3->path, sizeof(last_track));
+    }
+    crazypod_m3k_draw_home(*selection, 0);
+
+    while (true)
+    {
+        int action;
+        action = get_action(CONTEXT_MAINMENU, HZ / 2);
+
+        if (action == ACTION_NONE)
+        {
+            struct mp3entry *id3 = audio_current_track();
+            const char *path = id3 ? id3->path : "";
+            if (strcmp(last_track, path))
+            {
+                strmemccpy(last_track, path, sizeof(last_track));
+                crazypod_m3k_draw_home(*selection, 0);
+            }
+            else
+                crazypod_m3k_draw_playing(true);
+        }
+        else if (action == ACTION_STD_PREV || action == ACTION_STD_PREVREPEAT)
+        {
+            *selection = (*selection + count - 1) % count;
+            crazypod_m3k_animate(*selection, -1);
+        }
+        else if (action == ACTION_STD_NEXT || action == ACTION_STD_NEXTREPEAT)
+        {
+            *selection = (*selection + 1) % count;
+            crazypod_m3k_animate(*selection, 1);
+        }
+        else if (action == ACTION_STD_OK)
+        {
+            const struct menu_item_ex *item = root_menu__[*selection];
+            if ((item->flags & MENU_TYPE_MASK) == MT_RETURN_VALUE)
+                result = item->value;
+            else
+                result = do_menu(item, NULL, NULL, false);
+            break;
+        }
+        else if (action == ACTION_TREE_WPS)
+        {
+            result = GO_TO_WPS;
+            break;
+        }
+        else if (action == ACTION_STD_MENU || action == ACTION_STD_QUICKSCREEN)
+        {
+            result = GO_TO_MAINMENU;
+            break;
+        }
+        else if (default_event_handler(action) == SYS_USB_CONNECTED)
+        {
+            result = MENU_ATTACHED_USB;
+            break;
+        }
+    }
+
+    if (crazypod_m3k_wallpaper_loaded)
+        lcd_bmp(&crazypod_m3k_wallpaper, 0, 0);
+    else
+        lcd_clear_display();
+    lcd_update();
+
+    return result;
+}
