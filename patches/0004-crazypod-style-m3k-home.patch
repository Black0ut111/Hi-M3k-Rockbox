+static void crazypod_m3k_scroll_text(const char *text, int x, int y,
+                                     int width, unsigned speed)
+{
+    struct viewport vp;
+    struct viewport *old_vp;
+    int text_width;
+    int offset = 0;
+
+    lcd_getstringsize((const unsigned char *)text, &text_width, NULL);
+    if (text_width > width)
+    {
+        int cycle = text_width + 32;
+        offset = ((current_tick / speed) * 2) % cycle;
+        if (offset > text_width - width + 20)
+            offset = 0;
+    }
+
+    viewport_set_defaults(&vp, SCREEN_MAIN);
+    vp.x = x;
+    vp.y = y;
+    vp.width = width;
+    vp.height = 16;
+    vp.fg_pattern = lcd_get_foreground();
+    vp.bg_pattern = lcd_get_background();
+    vp.drawmode = DRMODE_FG;
+    old_vp = lcd_set_viewport(&vp);
+    lcd_putsxy(-offset, 0, text);
+    lcd_set_viewport(old_vp);
+}
+
+static void crazypod_m3k_apply_theme(void)
+{
+    static bool skins_loaded;
+
+    global_settings.bg_color = LCD_RGBPACK(12, 14, 23);
+    global_settings.fg_color = LCD_RGBPACK(225, 229, 240);
+    global_settings.lss_color = LCD_RGBPACK(231, 70, 86);
+    global_settings.lse_color = LCD_RGBPACK(160, 62, 128);
+    global_settings.lst_color = LCD_WHITE;
+    screens[SCREEN_MAIN].set_background(global_settings.bg_color);
+    screens[SCREEN_MAIN].set_foreground(global_settings.fg_color);
+
+#ifdef HAVE_ALBUMART
+    if (global_settings.album_art == AA_OFF)
+    {
+        global_settings.album_art = AA_PREFER_EMBEDDED;
+        set_albumart_mode(global_settings.album_art);
+    }
+#endif
+
+    if (!skins_loaded)
+    {
+        strmemccpy(global_settings.wps_file, "CrazyThemify",
+                   sizeof(global_settings.wps_file));
+        strmemccpy(global_settings.sbs_file, "CrazyThemify",
+                   sizeof(global_settings.sbs_file));
+        strmemccpy(global_settings.backdrop_file,
+                   ROCKBOX_DIR "/backdrops/CrazyPod.bmp",
+                   sizeof(global_settings.backdrop_file));
+        settings_apply_skins();
+        skins_loaded = true;
+    }
+}
