+static void crazypod_m3k_load_assets(void)
+{
+    static bool loaded;
+
+    if (loaded)
+        return;
+
+    crazypod_m3k_wallpaper.data = crazypod_m3k_wallpaper_data;
+    crazypod_m3k_wallpaper_loaded = read_bmp_file(
+        ROCKBOX_DIR "/backdrops/CrazyPod.bmp", &crazypod_m3k_wallpaper,
+        sizeof(crazypod_m3k_wallpaper_data), FORMAT_NATIVE | FORMAT_DITHER,
+        NULL) > 0;
+
+    crazypod_m3k_icons.data = crazypod_m3k_icons_data;
+    crazypod_m3k_icons_loaded = read_bmp_file(
+        ROCKBOX_DIR "/icons/CrazyPod-menu.bmp", &crazypod_m3k_icons,
+        sizeof(crazypod_m3k_icons_data), FORMAT_NATIVE,
+        NULL) > 0;
+    loaded = true;
+}
