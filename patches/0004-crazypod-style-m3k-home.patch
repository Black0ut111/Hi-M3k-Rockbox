+static bool crazypod_m3k_draw_albumart(int x, int y)
+{
+    int handle;
+    struct bitmap *bmp;
+
+    if (crazypod_m3k_aa_slot < 0)
+        return false;
+
+    handle = playback_current_aa_hid(crazypod_m3k_aa_slot);
+    if (handle < 0 || bufgetdata(handle, 0, (void *)&bmp) <= 0)
+        return false;
+
+    lcd_bmp_part(bmp, 0, 0, x, y, bmp->width, bmp->height);
+    return true;
+}
+#endif
