+static void crazypod_m3k_draw_card(int selection, int x, bool active)
+{
+    static const unsigned colors[] = {
+        LCD_RGBPACK(231, 70, 86), LCD_RGBPACK(80, 132, 255),
+        LCD_RGBPACK(54, 190, 150), LCD_RGBPACK(160, 92, 245),
+        LCD_RGBPACK(240, 155, 55), LCD_RGBPACK(44, 176, 214)
+    };
+
+    lcd_set_foreground(colors[selection % ARRAYLEN(colors)]);
+    lcd_fillrect(x, 48, 184, 180);
+    lcd_set_foreground(active ? LCD_WHITE : LCD_RGBPACK(190, 195, 210));
+    lcd_drawrect(x, 48, 184, 180);
+    crazypod_m3k_draw_icon(selection, x + 64, 84);
+    lcd_set_foreground(LCD_WHITE);
+    crazypod_m3k_card_text(crazypod_m3k_label(root_menu__[selection]), x, 163);
+    lcd_set_foreground(LCD_RGBPACK(230, 235, 245));
+    crazypod_m3k_card_text(active ? "SELECT TO OPEN" : "", x, 194);
+}
+
+static void crazypod_m3k_draw_home(int selection, int offset)
+{
+    char status[32];
+    char playing[40];
+    int count = MENU_GET_COUNT(root_menu_.flags);
+    int previous = (selection + count - 1) % count;
+    int next = (selection + 1) % count;
+    int battery = battery_level();
+    struct tm *now = get_time();
+    struct mp3entry *id3 = audio_current_track();
+
+    lcd_set_drawmode(DRMODE_SOLID);
+    lcd_set_background(LCD_RGBPACK(12, 14, 23));
+    lcd_set_foreground(LCD_RGBPACK(12, 14, 23));
+    lcd_clear_display();
+
+    lcd_set_foreground(LCD_RGBPACK(225, 229, 240));
+    lcd_putsxy(12, 9, "CrazyPod");
+    snprintf(status, sizeof(status), "%02d:%02d  %d%%", now->tm_hour,
+             now->tm_min, battery < 0 ? 0 : battery);
+    {
+        int width;
+        lcd_getstringsize((const unsigned char *)status, &width, NULL);
+        lcd_putsxy(LCD_WIDTH - width - 12, 9, status);
+    }
+
+    crazypod_m3k_draw_card(previous, 28 - 192 + offset, false);
+    crazypod_m3k_draw_card(next, 28 + 192 + offset, false);
+    crazypod_m3k_draw_card(selection, 28 + offset, true);
+
+    if ((audio_status() & AUDIO_STATUS_PLAY) && id3)
+    {
+        const char *title = id3->title ? id3->title : "Now Playing";
+        snprintf(playing, sizeof(playing), "%s  %.26s",
+                 (audio_status() & AUDIO_STATUS_PAUSE) ? ">" : "||", title);
+        lcd_set_foreground(LCD_RGBPACK(35, 40, 56));
+        lcd_fillrect(12, 236, LCD_WIDTH - 24, 34);
+        lcd_set_foreground(LCD_WHITE);
+        lcd_putsxy(22, 246, playing);
+    }
+
+    for (int i = 0; i < count; i++)
+    {
+        int x = (LCD_WIDTH - count * 10) / 2 + i * 10;
+        lcd_set_foreground(i == selection ? LCD_WHITE : LCD_RGBPACK(76, 82, 102));
+        lcd_fillrect(x, 280, i == selection ? 7 : 4, 4);
+    }
+
+    lcd_set_foreground(LCD_RGBPACK(145, 152, 172));
+    crazypod_m3k_center_text("UP / DOWN  browse", 301);
+    lcd_update();
+}
+
+static void crazypod_m3k_animate(int selection, int direction)
+{
+    int start = direction > 0 ? 192 : -192;
+    for (int frame = 5; frame >= 0; frame--)
+    {
+        crazypod_m3k_draw_home(selection, start * frame / 6);
+        sleep(HZ / 60 + 1);
+    }
+}
+
+static int crazypod_m3k_home(int *selection)
+{
+    int count = MENU_GET_COUNT(root_menu_.flags);
+
+    if (*selection < 0 || *selection >= count)
+        *selection = 0;
+
+    while (true)
+    {
+        int action;
+        crazypod_m3k_draw_home(*selection, 0);
+        action = get_action(CONTEXT_MAINMENU, TIMEOUT_BLOCK);
+
+        if (action == ACTION_STD_PREV || action == ACTION_STD_PREVREPEAT)
+        {
+            *selection = (*selection + count - 1) % count;
+            crazypod_m3k_animate(*selection, -1);
+        }
+        else if (action == ACTION_STD_NEXT || action == ACTION_STD_NEXTREPEAT)
+        {
+            *selection = (*selection + 1) % count;
+            crazypod_m3k_animate(*selection, 1);
+        }
+        else if (action == ACTION_STD_OK)
+        {
+            const struct menu_item_ex *item = root_menu__[*selection];
+            if ((item->flags & MENU_TYPE_MASK) == MT_RETURN_VALUE)
+                return item->value;
+            return do_menu(item, NULL, NULL, false);
+        }
+        else if (action == ACTION_TREE_WPS)
+            return GO_TO_WPS;
+        else if (action == ACTION_STD_MENU || action == ACTION_STD_QUICKSCREEN)
+            return GO_TO_MAINMENU;
+        else if (default_event_handler(action) == SYS_USB_CONNECTED)
+            return MENU_ATTACHED_USB;
+    }
+}
