diff --git a/firmware/export/storage.h b/firmware/export/storage.h
index c5db164..1b8738e 100644
--- a/firmware/export/storage.h
+++ b/firmware/export/storage.h
@@ -207,7 +207,8 @@ static inline void storage_sleep(void) {};
         #define STORAGE_FUNCTION(NAME) (sd_## NAME)
         #define storage_spindown(sec) sd_spindown(sec)
         #define storage_set_storage_mode(mode) stub_storage_set_storage_mode(mode)
-        #define storage_get_ssd_mode() stub_storage_get_ssd_mode()
+        #undef storage_get_ssd_mode
+        #define storage_get_ssd_mode() false
         #define storage_spin() sd_spin()
 
         #define storage_enable(on) sd_enable(on)
diff --git a/firmware/drivers/usb-designware.c b/firmware/drivers/usb-designware.c
index 5d08ea1..25ce55e 100644
--- a/firmware/drivers/usb-designware.c
+++ b/firmware/drivers/usb-designware.c
@@ -44,7 +44,7 @@
 /* Diagnostic counter: incomplete isochronous IN transfers */
 static volatile int iisoixfr_count = 0;
 
-#ifdef USB_ENABLE_AUDIO
+#if defined(USB_ENABLE_AUDIO) && defined(IPOD_6G)
 extern bool usb_audio_source_streaming(void);
 #endif
 
@@ -936,7 +936,7 @@ static void usb_dw_control_received(struct usb_ctrlrequest* req)
         /* Skip EP0 IN flush during ISO streaming — the flush calls
          * usb_dw_wait_for_ahb_idle() which busy-waits for all DMA to
          * stop, potentially disrupting active ISO IN transfers. */
-#ifdef USB_ENABLE_AUDIO
+#if defined(USB_ENABLE_AUDIO) && defined(IPOD_6G)
         if (!usb_audio_source_streaming())
 #endif
             usb_dw_flush_endpoint(0, USB_DW_EPDIR_IN);
