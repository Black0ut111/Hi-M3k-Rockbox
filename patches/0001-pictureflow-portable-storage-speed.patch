+static bool extract_embedded_albumart(const struct mp3entry *id3,
+                                      char *buf, int buflen)
+{
+    unsigned char copybuf[512];
+    unsigned long remaining;
+    const char *tmp;
+    int type;
+    int src = -1;
+    int dst = -1;
+    bool ok = false;
+
+    if (!id3->path[0] || !id3->has_embedded_albumart ||
+        id3->albumart.size == 0)
+        return false;
+
+    type = id3->albumart.type & AA_CLEAR_FLAGS_MASK;
+    if (type == AA_TYPE_JPG)
+        tmp = EMBEDDED_ALBUMART_JPG_TMP;
+    else if (type == AA_TYPE_BMP)
+        tmp = EMBEDDED_ALBUMART_BMP_TMP;
+    else
+        return false;
+
+    src = rb->open(id3->path, O_RDONLY);
+    if (src < 0 || rb->lseek(src, id3->albumart.pos, SEEK_SET) < 0)
+        goto out;
+
+    dst = rb->open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (dst < 0)
+        goto out;
+
+    remaining = id3->albumart.size;
+    while (remaining > 0)
+    {
+        size_t amount = MIN(remaining, sizeof(copybuf));
+        ssize_t count = rb->read(src, copybuf, amount);
+        if (count <= 0 || rb->write(dst, copybuf, count) != count)
+            goto out;
+        remaining -= count;
+    }
+
+    rb->strlcpy(buf, tmp, buflen);
+    ok = true;
+
+out:
+    if (dst >= 0)
+        rb->close(dst);
+    if (src >= 0)
+        rb->close(src);
+    if (!ok)
+        rb->remove(tmp);
+    return ok;
+}
+
+static bool is_embedded_albumart_tmp(const char *file)
+{
+    return !rb->strcmp(file, EMBEDDED_ALBUMART_JPG_TMP) ||
+           !rb->strcmp(file, EMBEDDED_ALBUMART_BMP_TMP);
+}
